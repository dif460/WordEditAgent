# ---- Python 字节码 / 缓存 ----
__pycache__/
*.py[cod]
*$py.class
*.so

# ---- 虚拟环境 ----
.venv/
venv/
env/
ENV/
.env
!.env.example

# ---- 构建 / 分发产物 ----
build/
dist/
*.egg-info/
*.egg
.eggs/
*.whl

# ---- 类型检查 / 缓存 ----
.mypy_cache/
.ruff_cache/
.pytype/
.pyre/

# ---- 测试 / 覆盖率 ----
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
.cache/

# ---- 数据 / 运行时产物 ----
data/
uploads/*
!uploads/.gitkeep
outputs/*
!outputs/.gitkeep
templates/*
!templates/.gitkeep

# ---- 设备访问控制 ----
# 设备凭证 Cookie 的 HMAC 签名密钥（自动生成，切勿提交；删除后已发放的 Cookie 全部失效）
backend/.device_cookie_secret

# ---- Word / Office 临时锁文件 ----
~$*.docx
~$*.doc
~$*.xlsx
~$*.xls
~$*.ppt
~$*.pptx
~WRL*.tmp
*.tmp

# ---- 日志 ----
*.log
logs/
*.log.*

# ---- IDE / 编辑器 ----
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# ---- 前端（Node.js / pnpm / Next.js） ----
node_modules/
.next/
out/
*.tsbuildinfo
pnpm-debug.log*

# ---- Docker ----
docker-compose.override.yml
data/postgres/

# ---- Python 版本管理 ----
.python-version

# ---- 环境变量（禁止提交） ----
.env.local
.env.*.local
.env.development
.env.production

# ---- 运行时生成文件 ----
backend/allowed_devices.json
*.pid

# ---- 合并冲突 / 备份 ----
*.orig
*.bak
*.old
